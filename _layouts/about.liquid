---
layout: default
---

<div class="post">
  <!-- ========== 第一部分：滑动图片集（轮播图） ========== -->
  <div class="carousel-container mb-5">
    <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
      <!-- 指示点 -->
      <div class="carousel-indicators">
        {% for item in site.data.carousel_images limit: 5 %}
          <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="{{ forloop.index0 }}" 
            {% if forloop.first %}class="active" aria-current="true"{% endif %} 
            aria-label="Slide {{ forloop.index }}"></button>
        {% endfor %}
      </div>

      <!-- 轮播图片 -->
      <div class="carousel-inner rounded-4 shadow">
        {% for item in site.data.carousel_images limit: 5 %}
          <div class="carousel-item {% if forloop.first %}active{% endif %}">
            <img src="{{ item.image | relative_url }}" class="d-block w-100" alt="{{ item.alt | default: 'Slide image' }}" 
                 style="height: 400px; object-fit: cover;">
            {% if item.caption %}
              <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                <p class="mb-0 text-white">{{ item.caption }}</p>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <!-- 左右控制按钮 -->
      <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>

  <!-- ========== 第二部分：Technologies for a sustainable future ========== -->
  <div class="technologies-section mb-5">
    <h2 class="section-title">{{ page.technologies_title | default: "Technologies for a sustainable future" }}</h2>
    <div class="technologies-content">
      {{ content }}
    </div>
  </div>

  <!-- ========== 第三部分：Lab News ========== -->
  <div class="news-section">
    <h2 class="section-title">
      <a href="{{ '/news/' | relative_url }}" style="color: inherit; text-decoration: none;">
        {{ page.news_title | default: "Lab News" }}
      </a>
    </h2>
    {% if page.announcements and page.announcements.enabled %}
      {% include news.liquid limit=true %}
    {% else %}
      <p>No news available.</p>
    {% endif %}
  </div>
</div>

<!-- 添加自定义样式 -->
<style>
  .section-title {
    font-family: 'Times New Roman', 'SimSun', '宋体', serif;
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #eaeaea;
    color: #2c3e50;
  }
  
  .technologies-content {
    font-family: 'Times New Roman', 'SimSun', '宋体', serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
  }
  
  .carousel-container {
    margin-top: -1rem;
  }
  
  /* 响应式调整：手机端轮播图高度 */
  @media (max-width: 768px) {
    .carousel-inner img {
      height: 250px !important;
    }
  }
</style>