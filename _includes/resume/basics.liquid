<div class="row">
  <!-- 左侧：原有的表格信息（样式完全不变） -->
  <div class="col-md-8">
    <table class="table table-cv table-sm table-borderless table-responsive table-cv-map">
      {% assign skip_basics = 'image,profiles,location' | split: ',' %}
      {% for content in data[1] %}
        {%
          if (content[1] == "") or (skip_basics contains
          content[0])
        %}
          {% continue %}
        {% endif %}

        <tr>
          <td class="p-1 pr-2 font-weight-bold">
            <b>{{ content[0] | capitalize }}</b>
          </td>
          <td class="p-1 pl-2 font-weight-light text">
            <!-- 仅展示纯文本，无任何链接 -->
            {{ content[1] }}
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>
  
  <!-- 右侧：新增的照片（不影响左侧任何样式） -->
  <div class="col-md-4 text-end">
    {% if site.data.resume.basics.image %}
    <div class="cv-profile-image">
      <img src="{{ site.data.resume.basics.image | relative_url }}" 
           alt="Profile Image" 
           class="img-fluid rounded"
           style="max-width: 180px; width: 100%;">
    </div>
    {% endif %}
  </div>
</div>