<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item award-item">
      <div class="row align-items-center">
        <!-- 日期列 -->
        <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
          {% if content.date %}
            <span class="badge font-weight-bold danger-color-dark text-uppercase" style="min-width: 75px">
              {{ content.date | replace: '-', '.' }}
            </span>
          {% endif %}
        </div>
        <!-- 内容列 -->
        <div class="col-xs-10 col-sm-10 col-md-10">
          <h6 class="title font-weight-bold ml-1 ml-md-4 award-title">
            {{ content.title }}
          </h6>
          {% if content.awarder %}
            <h6 class="ml-1 ml-md-4 award-awarder">{{ content.awarder }}</h6>
          {% endif %}
          {% if content.summary %}
            <h6 class="ml-1 ml-md-4 award-summary">{{ content.summary }}</h6>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
