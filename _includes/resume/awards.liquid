<ul class="cv-list list-group list-group-flush">
  {% for content in data[1] %}
    <li class="cv-list-item list-group-item">
      <div class="cv-entry">
        <div class="cv-date">
          {% if content.date %}
            {% assign date = content.date | split: '-' | join: '.' %}
          {% else %}
            {% assign date = '' %}
          {% endif %}

          {% if date != '' %}
            <span class="cv-date-badge">{{ date }}</span>
          {% endif %}
        </div>

        <div class="cv-content">
          {% if content.title %}
            <div class="cv-title">
              {{ content.title }}
            </div>
          {% endif %}

          {% if content.awarder %}
            <div class="cv-awarder">
              {{ content.awarder }}
            </div>
          {% endif %}

          {% if content.summary %}
            <div class="cv-summary">
              {{ content.summary }}
            </div>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>