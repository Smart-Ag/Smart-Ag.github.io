<div class="announcements">
  <style>
    .announcements {
      font-family: 'Times New Roman', 'SimSun', '宋体', serif;
    }
    .announcements table {
      font-family: inherit;
    }
    .announcement-title {
      font-weight: normal;
      font-family: inherit;
    }
    
    /* ========== 新增：让 Lab News 左顶格显示 ========== */
    .announcements .table td,
    .announcements .table th {
      padding-left: 0 !important;
      padding-right: 0.5rem !important;
    }
    
    .announcements .table th {
      width: 0;
      min-width: 0;
      padding-right: 1rem !important;
    }
    
    /* 移动端适配 */
    @media (max-width: 768px) {
      .announcements .table td,
      .announcements .table th {
        padding-left: 0 !important;
        padding-right: 0.25rem !important;
      }
    }
  </style>

  {% if site.data.announcements != blank %}
    {% assign announcements = site.data.announcements %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in announcements %}
          <tr>
            <th scope="row" style="width: auto; vertical-align: top; white-space: nowrap;">
              {% if item.date %}
                {{ item.date | date: '%b %d, %Y' }}
              {% else %}
                <!-- 无日期则留空，不显示任何文字 -->
              {% endif %}
            </th>
            <td>
              <div class="announcement-item">
                <div class="announcement-header">
                  {% if item.link and item.link != "" %}
                    <a class="announcement-title" href="{{ item.link }}" target="_blank">
                      {{ item.title }}
                      <i class="fas fa-external-link-alt fa-xs ms-1"></i>
                    </a>
                  {% else %}
                    <span class="announcement-title">{{ item.title }}</span>
                  {% endif %}
                  {% if item.category %}
                    <span class="badge bg-primary ms-2">{{ item.category }}</span>
                  {% endif %}
                </div>
                {% if item.description %}
                  <div class="announcement-description small text-muted mt-1">
                    {{ item.description | truncatewords: 15 }}
                  </div>
                {% endif %}
                {% if item.tags and item.tags.size > 0 %}
                  <div class="announcement-tags mt-1">
                    {% for tag in item.tags limit: 3 %}
                      <span class="badge bg-light text-dark border me-1" style="font-size: 0.7rem;">
                        {{ tag }}
                      </span>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No announcements so far...</p>
  {% endif %}
</div>