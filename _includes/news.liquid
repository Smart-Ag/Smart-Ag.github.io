<div class="announcements">
  <style>
    /* 直接写在模板中的样式 */
    .announcements {
      font-family: 'Times New Roman', 'SimSun', '宋体', serif;
    }
    .announcements th {  /* 针对所有日期单元格 */
      font-weight: bold;
    }
    .announcement-title {
      font-weight: bold;
    }
  </style>

  <!-- 原有代码保持不变，但可以为日期添加类名以便精确控制 -->
  {% for item in announcements... %}
    <tr>
      <th scope="row" class="announcement-date" style="width: 20%; vertical-align: top;">
        {{ item.date | date: '%b %d, %Y' }}
      </th>
      ...
    </tr>
  {% endfor %}
</div>
<div class="announcements">
  {% if site.data.announcements != blank %}
    {% assign announcements_size = site.data.announcements | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and announcements_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign announcements = site.data.announcements | sort: 'date' | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign announcements_limit = page.announcements.limit %}
        {% else %}
          {% assign announcements_limit = announcements_size %}
        {% endif %}
        {% for item in announcements limit: announcements_limit %}
          <tr>
            <th scope="row" style="width: 20%; vertical-align: top;">
              {{ item.date | date: '%b %d, %Y' }}
            </th>
            <td>
              <div class="announcement-item">
                <div class="announcement-header">
                  {% if item.link and item.link != "" %}
                    <a class="announcement-title" href="{{ item.link }}" target="_blank">
                      {{ item.title }}
                      <i class="fas fa-external-link-alt fa-xs ms-1"></i>
                    </a>
                  {% else %}
                    <span class="announcement-title">{{ item.title }}</span>
                  {% endif %}
                  {% if item.category %}
                    <span class="badge bg-primary ms-2">{{ item.category }}</span>
                  {% endif %}
                </div>
                {% if item.description %}
                  <div class="announcement-description small text-muted mt-1">
                    {{ item.description | truncatewords: 15 }}
                  </div>
                {% endif %}
                {% if item.tags and item.tags.size > 0 %}
                  <div class="announcement-tags mt-1">
                    {% for tag in item.tags limit: 3 %}
                      <span class="badge bg-light text-dark border me-1" style="font-size: 0.7rem;">
                        {{ tag }}
                      </span>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No announcements so far...</p>
  {% endif %}
</div>